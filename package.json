{
  "name": "chefs-shelf-backend-tests",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "emulators": "firebase emulators:start --only auth,firestore --project demo-chefs-shelf",
    "test:rules": "firebase emulators:exec --only auth,firestore --project demo-chefs-shelf 'node --test --test-concurrency=1 backend_tests/*.test.mjs'",
    "test:rules:running": "node --test --test-concurrency=1 backend_tests/*.test.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.1",
    "playwright-core": "1.64.1"
  }
}
